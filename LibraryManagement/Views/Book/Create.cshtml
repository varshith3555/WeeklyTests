@model LibraryManagement.Models.Book

<div class="book-form">
    <h2>Add Book</h2>

    <form asp-action="Create" method="post">

        <div class="form-group">
            <label>Title</label>
            <input asp-for="Title" type="text" />
        </div>

        <div class="form-group">
            <label>Author</label>
            <input asp-for="Author" type="text" />
        </div>

        <div class="form-group">
            <label>Price</label>
            <input asp-for="Price" type="number" step="0.01" />
        </div>

        <button type="submit" class="btn-submit">Save</button>

    </form>
</div>